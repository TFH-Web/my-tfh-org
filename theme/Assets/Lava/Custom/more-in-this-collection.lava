{% assign currentItem =  Item.Id %}
{% assign parentItem = Item.ParentItems | First %}
{% assign parentItemId = parentItem.ContentChannelItem.Id %}

<div class="pt-4 pb-5 mb-5">
    <div class="row mt-3">
        <div class="col-xs-12{% if Item.ContentChannelId == 75 %} col-md-10 col-md-offset-1{% endif %}">
            <h3>More from this Collection</h3>
            <hr>
            <div class="d-flex flex-wrap flex-row row" style="row-gap: 0.5rem;">

                    <!-- Get the Parent Resource Topic -->
                    {% contentchannelitem where:'Id == "{{parentItemId}}"' %}
                        {% for item in contentchannelitemItems %}

                            <!-- Get all the child Resource Items -->
                            {% for childItem in item.ChildItems %}
                                {% if childItem.ChildContentChannelItem.Id != currentItem and childItem.ChildContentChannelItem.Status == 'Approved' %}
                                    {% assign childItemItem = childItem.ChildContentChannelItem %}
                                    {[ groupresourcecard contentchannelitem:childItemItem detailpageurl:'group-resources/resources/{slug}' ]}
                                {% endif %}
                            {% endfor %}
                        {% endfor %}
                    {% endcontentchannelitem %}

            </div>
        </div>
    </div>
</div>
