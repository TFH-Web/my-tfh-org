{% assign pageCount = Page.Pages | Size %}
<style>
    .navigation .nav li {
        width: calc(100% / {{ pageCount }});
    }
</style>

{% if Page.DisplayChildPages and Page.Pages != empty %}
    <div class="position-relative">
        <button class="nav-scroller nav-scroller-lt js-leftbtn" type="button"><i class="fa fa-chevron-left"></i></button>
        <button class="nav-scroller nav-scroller-rt js-rightbtn" type="button"><i class="fa fa-chevron-right"></i></button>
    </div>
    <ul class="nav navbar-nav js-navbar accordion">
		{% for childPage in Page.Pages %}
            <li{% if childPage.Current %} class="active"{% endif %}>
                <div class="d-flex flex-wrap flex-row d-sm-block align-items-center">
                    {% if childPage.DisplayChildPages == 'true' and childPage.Pages != empty %}
                        {% assign accordionMenuItem = 'accordion-menu-item' %}
                    {% endif %}
                    <a  class="menu-item {{ accordionMenuItem }} d-inline-block d-sm-block" href="{{ childPage.Url }}">
                        <i class="{{ childPage.IconCssClass }}"></i><br>
                        {{ childPage.Title }}
                        {% if childPage.Description %}
                        <p class="d-block d-sm-none small">{{ childPage.Description }}</p>
                        {% endif %}
                    </a>
                    {% if childPage.DisplayChildPages == 'true' and childPage.Pages != empty %}
                        <a class="accordion-btn d-inline-block d-sm-none pull-right collapsed p-0 m-auto" type="button" data-toggle="collapse" data-target="#collapse{{ childPage.Title | ToPascal }}" aria-expanded="false" aria-controls="collapse{{ childPage.Title | ToPascal }}">
                            <i class="d-block fa fa-chevron-down fa-lite"></i>
                        </a>
                    {% endif %}
                </div>

                {% if childPage.DisplayChildPages == 'true' and childPage.Pages != empty %}
                    <div id="collapse{{ childPage.Title | ToPascal }}" class="collapse" aria-labelledby="headingOne" data-parent="#accordionExample">
                        <ul class="d-block d-sm-none navbar-childnav js-navbar text-left">
                            {% for secondarychildPage in childPage.Pages %}
                                <li{% if secondarychildPage.Current %} class="active"{% endif %}>
                                    <a href="{{ secondarychildPage.Url }}">
                                        <i class="{{ secondarychildPage.IconCssClass }}"></i><br>
                                        {{ secondarychildPage.Title }}
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}
            </li>
        {% endfor %}
        {% for includedPage in IncludePageList %}
            {% assign path = 'Global' | Page:'Path' %}
            {% assign attributeParts = includedPage | PropertyToKeyValue %}
            <li  class="nav-include d-block d-sm-none {% if path == attributeParts.Value %}active{% endif %}">
                <a href="{{ attributeParts.Value }}">{{ attributeParts.Key }}</a>
            </li>
        {% endfor %}
    </ul>
{% endif %}

<script>
    Sys.Application.add_load(function() {
        $(function() {
            $( ".navbar-toggle" ).click(function( ) {
                console.log('Fired');
                $('body').toggleClass("overflow-hidden");
                $('header').toggleClass("mobile-header");
                $('.js-static-top').toggleClass("mobile-wrap");
                $('.js-menuslider').toggleClass("mobile-scroll");
                $('.js-menuslider').toggleClass("mobile-hide");
                $('.js-subnav').toggleClass("d-none");
                $('.js-mobile-open').toggleClass("d-none");
                $('.js-mobile-close').toggleClass("d-none");
            });
        });
    });
</script>

<style>
    .mobile-scroll .accordion{
        overflow-y: scroll;
    }
    .mobile-header {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        z-index: 200;
        background: #f5f5f5;
    }
    header.mobile-header .container {
        border: 0;
    }
</style>
